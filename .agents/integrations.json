{
  "schemaVersion": 2,
  "fallback": {
    "instructions": "AGENTS.md",
    "skills": ".agents/skills"
  },
  "agents": [
    {
      "id": "codex",
      "instructions": {
        "mode": "native",
        "path": "AGENTS.md"
      },
      "skills": {
        "mode": "native",
        "path": ".agents/skills"
      },
      "hooks": {
        "preToolUseConfig": ".codex/hooks.json"
      }
    },
    {
      "id": "claude-code",
      "instructions": {
        "mode": "adapter",
        "path": "CLAUDE.md",
        "source": "AGENTS.md"
      },
      "skills": {
        "mode": "adapter",
        "path": ".claude/skills"
      },
      "hooks": {
        "preToolUseConfig": ".claude/settings.json",
        "postToolUseConfig": ".claude/settings.json"
      }
    },
    {
      "id": "github-copilot",
      "instructions": {
        "mode": "adapter",
        "path": ".github/copilot-instructions.md",
        "source": "AGENTS.md"
      },
      "skills": {
        "mode": "native",
        "path": ".agents/skills"
      },
      "hooks": {
        "preToolUseConfig": ".github/hooks/mimizuku-policy.json"
      }
    }
  ]
}
